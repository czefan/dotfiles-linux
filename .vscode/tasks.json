{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "chezmoi: Auto-sync on Open & Save",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/.vscode/sync-watch.sh"
            ],
            "isBackground": true,
            "runOptions": {
                "runOn": "folderOpen"
            },
            "presentation": {
                "reveal": "never",
                "panel": "dedicated"
            },
            "problemMatcher": []
        }
    ]
}
