# 1. 环境变量与工具链激活
export PATH="$HOME/.local/bin:$PATH"
command -v mise &>/dev/null && eval "$(mise activate zsh)"
command -v zoxide &>/dev/null && eval "$(zoxide init zsh)"

# 2. 历史记录设置
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt share_history hist_ignore_all_dups hist_ignore_space

# 3. 自动补全系统
mkdir -p ~/.cache/zsh
autoload -Uz compinit && compinit -u -C -d ~/.cache/zsh/zcompdump
zstyle ':completion:*' menu select

# 4. fzf 联动（fd 搜索 + bat/eza 实时预览）
if command -v fzf &>/dev/null; then
    eval "$(fzf --zsh)"
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    export FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git'
    export FZF_DEFAULT_OPTS="--height 40% --layout=reverse --border"
    export FZF_CTRL_T_OPTS="--preview 'bat --color=always --line-range :500 {}' --preview-window=right:50%:wrap"
    export FZF_ALT_C_OPTS="--preview 'eza --tree --level=2 --icons --color=always {}' --preview-window=right:50%"
fi

# 5. 系统插件
[[ -f /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]] && source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
[[ -f /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] && source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# 6. 常用别名
alias ls='eza --icons'
alias ll='eza -lh --icons --git'
alias la='eza -lha --icons --git'
alias cat='bat --paging=never'
alias scodex='unshare -U -r -m bash -c "mount -t tmpfs none /mnt && codex"'
alias ccs='GDK_DPI_SCALE=2 cc-switch'
alias ccs-update='gh release download -R farion1231/cc-switch -p "*x86_64.deb" -O cc-switch.deb --clobber && sudo apt install -y ./cc-switch.deb && rm -f cc-switch.deb'

# 7. Starship 提示符
command -v starship &>/dev/null && eval "$(starship init zsh)"
